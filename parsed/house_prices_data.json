  "model": {
    "description": "房价基本面模型与系数校准",
    "formula_base": "房价长期涨幅 ≈ 人口增长 + 收入增长 - 供给增长",
    "formula_calibrated": "理论房价涨幅 = 0.35×常住人口增幅 + 0.30×收入增幅 - 0.15×人均住房供给增幅（全局均值）",
    "coefficients": [
      {"tier": "沿海核心（深圳/广州/厦门等）", "pop_coef": 0.7, "income_coef": 0.6, "supply_coef": -0.3, "note": "人口以高学历青壮年为主、供给稀缺，转化效率最高"},
